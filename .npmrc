# Consola limpia al ejecutar el sistema.
# loglevel=silent elimina los encabezados "> paquete@version script" que imprime
# npm en cada paso de la cadena (preall, all, dev:all). El resultado de los
# scripts (banner del backend, salida de Vite, builds) se sigue mostrando porque
# lo emiten los procesos hijos directamente a la consola.
loglevel=silent
