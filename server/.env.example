# =====================================================
# PrecisionTrucks HelpDesk — Variables de Entorno del SERVIDOR
# Copia este archivo como server/.env y rellena los valores reales.
# NUNCA subas el .env al repositorio.
# =====================================================

# ---- SERVIDOR ----
PORT=3001
NODE_ENV=development # development | production

# ---- BASE DE DATOS MySQL ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=TU_PASSWORD_AQUI
DB_NAME=precision_helpdesk
DB_SSL=false # true solo con certificado válido en producción

# ---- SEGURIDAD JWT ----
# Genera un secreto seguro con:
# node -e "require('crypto').randomBytes(64).toString('hex')|console.log"
JWT_SECRET=CAMBIA_ESTO_POR_UN_SECRETO_DE_64_BYTES_MINIMO

# ---- EMAIL / SMTP ----
# Nodemailer es genérico: el mismo código sirve para Gmail, Zoho u Outlook.
# Solo cambia este bloque. SMTP_SECURE se deduce del puerto (465 = SSL);
# solo define SMTP_SECURE si tu proveedor usa otro criterio.

# Zoho Mail (gratuito @zohomail.com)
#   1) Zoho Mail → Configuración → Cuentas de correo → SMTP: "Permitir"
#   2) Genera una CONTRASEÑA ESPECÍFICA PARA LA APLICACIÓN (si tienes 2FA,
#      es obligatoria; la contraseña normal no sirve para SMTP)
#   3) Copia aquí el servidor que Zoho te muestre en "Detalles del servidor
#      saliente": smtp.zoho.com (o smtppro.zoho.com con dominio propio)
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USER=tu_correo@zohomail.com
SMTP_PASS=tu_contrasena_especifica_de_aplicacion
# El remitente DEBE coincidir con SMTP_USER o Zoho responde "Transmisión no permitida"
SMTP_FROM="Precision HelpDesk" <tu_correo@zohomail.com>

# Gmail (alternativa): SMTP_HOST=smtp.gmail.com / SMTP_PORT=587
#   con SMTP_PASS = contraseña de aplicación de Google (requiere 2FA)
# Outlook (alternativa): SMTP_HOST=smtp.office365.com / SMTP_PORT=587

# ---- CORS / URL PUBLICA ----
# IP LAN ACTUAL de la máquina de desarrollo (cambia con DHCP — ipconfig).
CORS_ORIGIN=http://192.168.31.121:5173
APP_URL=http://192.168.31.121:5173

# ---- ZOHO OAUTH (Login con Zoho — Server-based) ----
# Client ID / Secret del API Console de Zoho (NO subirlos al repo)
ZOHO_CLIENT_ID=[SECURITY_DATA]
ZOHO_CLIENT_SECRET=PEGAR_AQUI_EL_CLIENT_SECRET
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
# Callbacks registrados en el API Console de Zoho (coincidencia exacta).
# IMPORTANTE: si la IP LAN cambia (DHCP), registrar la nueva callback en
# api.zoho.com → tu Client ID → "Authorized Redirect URIs" y actualizar aquí.
ZOHO_REDIRECT_URIS=http://192.168.31.121:3001/api/auth/zoho/callback,http://localhost:3001/api/auth/zoho/callback
ZOHO_REDIRECT_URI=http://192.168.31.121:3001/api/auth/zoho/callback
ZOHO_SCOPES=openid,email,profile

# ---- PRODUCCIÓN — cambia estos valores al desplegar ----
# NODE_ENV=production
# CORS_ORIGIN=https://tu-dominio.com
# APP_URL=https://tu-dominio.com
# DB_HOST=tu-host-mysql-produccion
# DB_SSL=true (si tu proveedor MySQL lo requiere)
