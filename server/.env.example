# ==== Variables de entorno - PrecisionTrucks HelpDesk
# Copia este archivo a .env y rellena los valores.

# ============ Opcional ============
PORT=3001
APP_URL=http://localhost:8080
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=<generar con: openssl rand -base64 32>
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=<tu contraseña>
DB_NAME=precisiontrucks_helpdesk
ZOHO_CLIENT_ID=<id de cliente Zoho>
ZOHO_CLIENT_SECRET=<secret de cliente Zoho>
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_REDIRECT_URI=https://<tudominio>/api/auth/zoho/callback
ZOHO_SCOPES=openid email profile
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<tu correo>
SMTP_PASSWORD=<app password>
SMTP_FROM=HelpDesk <no-reply@tu-dominio.com>
SOCKET_JWT_SECRET=<clave opcional>
