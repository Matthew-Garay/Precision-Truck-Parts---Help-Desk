# =============================================================================
#  Variables de entorno — Precision Truck Parts · Mesa de Ayuda (HelpDesk)
# =============================================================================
#  Copia este archivo como server/.env y rellena los valores.
#  NUNCA subas server/.env a git (ya está en .gitignore).
#  Guía completa de producción: docs/despliegue.md
# =============================================================================

# ── Servidor ─────────────────────────────────────────────────────────────────
# development = local · production = servidor publicado (exige APP_URL y
# CORS_ORIGIN, sirve el frontend compilado desde dist/ y oculta errores internos)
NODE_ENV=development
PORT=3001
# Interfaz de red: 0.0.0.0 = toda la red local (desarrollo) · 127.0.0.1 = solo
# este equipo (producción detrás de Caddy, así el puerto 3001 no queda expuesto).
HOST=0.0.0.0

# URL pública del sistema (la que se escribe en el navegador), sin "/" final.
#   local:       http://localhost:5173
#   producción:  https://ptp-helpdesk.duckdns.org
APP_URL=http://localhost:5173
# Origen permitido para la API y Socket.io. En producción = APP_URL.
CORS_ORIGIN=http://localhost:5173

# Firma de las sesiones. OBLIGATORIO mínimo 32 caracteres en producción.
# Genera una:  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=<pega aquí una clave aleatoria de 64 caracteres o más>

# ── Base de datos MySQL 8 ────────────────────────────────────────────────────
# Usa un usuario propio de la aplicación, NO root (ver deploy/mysql-usuario.sql).
DB_HOST=localhost
DB_PORT=3306
DB_USER=helpdesk_app
DB_PASSWORD=<contraseña fuerte del usuario helpdesk_app>
DB_NAME=precision_helpdesk
# true solo si MySQL está en otro servidor y exige SSL.
DB_SSL=false
# Conexiones simultáneas a MySQL (20 es suficiente para una mesa de ayuda).
DB_POOL_SIZE=20

# ── Correo (recuperación de contraseña y avisos) ─────────────────────────────
# Zoho Mail: smtp.zoho.com:587 · Gmail: smtp.gmail.com:587 (con "contraseña de aplicación")
# Si se deja vacío, el sistema funciona pero no envía correos.
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USER=<cuenta de correo que envía>
# Ojo: la variable se llama SMTP_PASS (no SMTP_PASSWORD).
SMTP_PASS=<contraseña de aplicación del correo>
SMTP_FROM=Mesa de Ayuda PTP <cuenta-que-envia@ptp.com.mx>

# ── Inicio de sesión con Zoho (opcional) ─────────────────────────────────────
# Crear la app "Server-based" en https://api-console.zoho.com y registrar ahí
# EXACTAMENTE las mismas URIs de redirección que se ponen abajo.
ZOHO_CLIENT_ID=<Client ID de Zoho>
ZOHO_CLIENT_SECRET=<Client Secret de Zoho>
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_SCOPES=openid,email,profile
# Una o varias URIs separadas por coma (p. ej. dominio público y red local).
# El sistema elige la que coincide con el host del navegador.
ZOHO_REDIRECT_URIS=https://ptp-helpdesk.duckdns.org/api/auth/zoho/callback
ZOHO_REDIRECT_URI=https://ptp-helpdesk.duckdns.org/api/auth/zoho/callback

# ── Solo desarrollo (Vite) ───────────────────────────────────────────────────
VITE_PORT=5173
VITE_BACKEND_URL=http://localhost:3001
