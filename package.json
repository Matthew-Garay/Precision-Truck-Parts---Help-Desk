{
  "name": "precisiontrucks-helpdesk",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "cross-env NODE_ENV=production node --import ./src/Backend/load-env.js src/Backend/server.js",
    "dev:all": "concurrently -k -n \"BACK,FRONT\" -c \"yellow,cyan\" --timestamp --timefmt \"HH:mm:ss\" \"node --import ./src/Backend/load-env.js src/Backend/server.js\" \"wait-on http://localhost:3001/api/ping && vite --logLevel warn\"",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dompurify": "^3.4.11",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "file-saver": "^2.0.5",
    "file-type": "^22.0.1",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.12.0",
    "multer": "^2.1.1",
    "mysql2": "^3.22.3",
    "nodemailer": "^9.0.1",
    "pdfjs-dist": "^6.0.227",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.15.0",
    "sharp": "^0.35.3",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "xlsx": "^0.18.5",
    "xlsx-js-style": "^1.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.7",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^10.0.3",
    "cross-env": "^7.0.3",
    "tailwindcss": "^4.1.7",
    "vite": "^6.3.5",
    "wait-on": "^9.0.10"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
