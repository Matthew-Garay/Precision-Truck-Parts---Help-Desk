# ════════════════════════════════════════════════
#   PrecisionTrucks HelpDesk — .gitignore
#   Arquitectura: Monorepo (Vite + Express + MySQL)
# ════════════════════════════════════════════════

# ── Dependencias ─────────────────────────────────
node_modules/
.pnp
.pnp.js

# ── Build outputs ────────────────────────────────
dist/
dist-ssr/
build/
*.tsbuildinfo

# ── Variables de entorno (NUNCA versionar) ───────
# server/.env : credenciales MySQL, JWT_SECRET, SMTP. client/.env : VITE_*
.env
.env.local
.env.*.local
.env.production
.env.staging
server/.env
client/.env

# ── Estado en tiempo de ejecución ────────────────
server/workers/alert_state.json
server/workers/alert_state.json.tmp
server/workers/reset_tokens.json
server/workers/reset_tokens.json.tmp

# ── Storage (archivos subidos por usuarios) ──────
storage/Evidencias_Tickets/*
storage/Insumos/*
storage/Manuales/*
storage/_tmp_upload/*
# Mantener estructura de carpetas
!storage/Evidencias_Tickets/.gitkeep
!storage/Insumos/.gitkeep
!storage/Manuales/.gitkeep
!storage/_tmp_upload/.gitkeep

# ── Logs ─────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Cache de herramientas ─────────────────────────
.vite/
.eslintcache
.stylelintcache
*.cache

# ── Editores e IDEs ───────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.kate-swp

# ── Sistema Operativo ─────────────────────────────
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# ── Binarios y ejecutables ────────────────────────
*.exe
*.dll
*.so
*.dylib

# ── Certificados y llaves ─────────────────────────
*.pem
*.key
*.p12
*.pfx

# ── Cobertura de tests ────────────────────────────
coverage/
.nyc_output/

# ── Pruebas de estrés (Artillery) ───────────────────
stress-*.yml
run-stress.js
resultado-*.json
cloudflared*.exe

# ── Misc ──────────────────────────────────────────
ngrok.exe
*.local

# ── Respaldos locales de la base de datos ──────────────────────────────
# NUNCA versionar: contienen datos personales reales (nombres, correos,
backups/

# Dump de la base de datos guardado junto a la documentacion. Es el mismo
# caso que backups/: trae los INSERT de la tabla `empleado` con nombres,
# correos y hashes de contrasena reales. El esquema vive en
# docs/MYSQL Database/database.sql, que si se versiona.
docs/**/*.utf8.sql
docs/MYSQL Database/database.utf8.sql

# ── Copias de respaldo de codigo ───────────────────────────────────────
*.bak
*.orig
*.old
