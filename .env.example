# ── SERVIDOR ─────────────────────────────────────────────────
PORT=3001

# ── BASE DE DATOS MySQL ───────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=<tu_password_mysql>
DB_NAME=precision_helpdesk

# ── SEGURIDAD ─────────────────────────────────────────────────
# Genera uno con: node -e "require('crypto').randomBytes(64).toString('hex')|console.log"
JWT_SECRET=<secreto_hex_128_chars>

# ── EMAIL (SMTP) ──────────────────────────────────────────────
# Gmail: activa "Contraseñas de aplicación" en tu cuenta Google
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<tu_correo@gmail.com>
SMTP_PASS=<contraseña_de_aplicacion_gmail>
SMTP_FROM="Precision Truck Parts HelpDesk <<tu_correo@gmail.com>>"

# ── API ───────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173
