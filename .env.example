# ════════════════════════════════════════════════════════════════
#   PrecisionTrucks HelpDesk — Variables de Entorno
#   Copia este archivo como .env y rellena los valores reales.
#   NUNCA subas el .env al repositorio.
# ════════════════════════════════════════════════════════════════

# ── SERVIDOR ─────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development                     # development | production

# ── BASE DE DATOS MySQL ───────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=TU_PASSWORD_AQUI
DB_NAME=precision_helpdesk
DB_SSL=false                             # true solo con certificado válido en producción

# ── SEGURIDAD JWT ─────────────────────────────────────────────────
# Genera un secreto seguro con:
#   node -e "require('crypto').randomBytes(64).toString('hex')|console.log"
JWT_SECRET=CAMBIA_ESTO_POR_UN_SECRETO_DE_64_BYTES_MINIMO

# ── EMAIL / SMTP ──────────────────────────────────────────────────
# Para Gmail: habilita "Contraseñas de aplicación" en tu cuenta Google
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM="Precision HelpDesk" <tu_correo@gmail.com>

# ── FRONTEND / CORS ───────────────────────────────────────────────
# En desarrollo, dejar VITE_API_URL vacío para usar el proxy de Vite (evita CORS)
VITE_API_URL=
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173
